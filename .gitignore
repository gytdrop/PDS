# ==============================================================================
# 🛸 Drone Club Simulation Stack - .gitignore
# ==============================================================================

# --- Operating System & Desktop Files ---
.directory
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Python Bytecode & Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# --- C++ & CMake Build Artifacts ---
build/
*/build/
bin/
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake

# --- Obsidian Workspace & Local Cache ---
# Keep core configuration (app.json, graph.json, core-plugins.json)
# Ignore volatile window layout & transient cache
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/.trash/

# --- Simulation Runtime Logs & Temporary Artifacts ---
*.log
dataman
dataman.log
*.bag
*.mcap
/tmp/
*.swp
*~
*.bak

# --- Editors & IDEs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
